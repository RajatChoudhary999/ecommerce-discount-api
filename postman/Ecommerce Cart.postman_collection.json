                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/cart/update",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cart",
                "update"
              ]
            },
            "description": "Modifies quantity for an item already in cart. Setting qty to 0 removes the item."
          },
          "response": []
        },
        {
          "name": "Get Cart",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/cart/u1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
