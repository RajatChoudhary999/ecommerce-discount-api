    {
      "name": "2. Checkout",
      "item": [
        {
          "name": "Successful Checkout",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Ensure user u1 has at least 1 item in cart before checkout",
                  "pm.sendRequest({",
                  "    url: pm.collectionVariables.get('baseUrl') + '/api/cart/add',",
                  "    method: 'POST',",
                  "    header: { 'Content-Type': 'application/json' },",
                  "    body: {",
                  "        mode: 'raw',",
                  "        raw: JSON.stringify({ userId: 'u1', productId: 1, qty: 1 })",
                  "    }",
                  "}, function (err, res) {});"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    if (json.order && json.order.orderId) {",
                  "        pm.collectionVariables.set('orderId', json.order.orderId);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"u1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/checkout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "checkout"
              ]
            },
            "description": "Standard checkout. Validates stock, deducts inventory, transitions cart to CHECKED_OUT, and creates an immutable order snapshot."
          },
          "response": []
        },
        {
          "name": "Checkout with Idempotency-Key",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Ensure u_idemp has an item in cart",
                  "pm.sendRequest({",
                  "    url: pm.collectionVariables.get('baseUrl') + '/api/cart/add',",
                  "    method: 'POST',",
                  "    header: { 'Content-Type': 'application/json' },",
                  "    body: {",
                  "        mode: 'raw',",
                  "        raw: JSON.stringify({ userId: 'u_idemp', productId: 4, qty: 1 })",
                  "    }",
                  "}, function (err, res) {});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"u_idemp\",\n  \"idempotencyKey\": \"{{idempotencyKey}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/checkout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "checkout"
              ]
            },
            "description": "Initial checkout attempt supplying an Idempotency-Key. Creates order and stores response in idempotency cache."
          },
          "response": []
        },
        {
          "name": "Repeat checkout with same Idempotency-Key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"u_idemp\",\n  \"idempotencyKey\": \"{{idempotencyKey}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/checkout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "checkout"
              ]
            },
            "description": "Idempotency retry. Sends identical payload and Idempotency-Key. Safely returns cached order with HTTP 201 (idempotentReplay: true) without creating a second order or deducting inventory twice."
          },
          "response": []
        },
        {
          "name": "Checkout with insufficient inventory",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// 1. Add Headphones (productId: 5, stock: 1) to user u_stockout's cart",
                  "pm.sendRequest({",
                  "    url: pm.collectionVariables.get('baseUrl') + '/api/cart/add',",
                  "    method: 'POST',",
                  "    header: { 'Content-Type': 'application/json' },",
                  "    body: {",
                  "        mode: 'raw',",
                  "        raw: JSON.stringify({ userId: 'u_stockout', productId: 5, qty: 1 })",
                  "    }",
                  "}, function () {",
                  "    // 2. Concurrently buy the last headphone with another user u_competing to deplete stock to 0",
                  "    pm.sendRequest({",
                  "        url: pm.collectionVariables.get('baseUrl') + '/api/cart/add',",
                  "        method: 'POST',",
                  "        header: { 'Content-Type': 'application/json' },",
                  "        body: {",
                  "            mode: 'raw',",
                  "            raw: JSON.stringify({ userId: 'u_competing', productId: 5, qty: 1 })",
                  "        }",
                  "    }, function () {",
                  "        pm.sendRequest({",
                  "            url: pm.collectionVariables.get('baseUrl') + '/api/checkout',",
                  "            method: 'POST',",
                  "            header: { 'Content-Type': 'application/json' },",
                  "            body: {",
                  "                mode: 'raw',",
                  "                raw: JSON.stringify({ userId: 'u_competing' })",
                  "            }",
                  "        }, function () {});",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"u_stockout\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/checkout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "checkout"
              ]
            },
            "description": "Attempts to checkout when requested quantity exceeds available catalog inventory (e.g. stock bought by another customer). Rejects with HTTP 409 Conflict."
          },
          "response": []
        },
        {
          "name": "Checkout an already completed cart",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"u1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/checkout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "checkout"
              ]
            },
            "description": "Attempts to check out for a user whose cart was already finalized. Rejects because a completed cart cannot checkout more than once."
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Orders",
      "item": [
        {
          "name": "Get order by order ID",
          "request": {
            "method": "GET",
