                "{{orderId}}"
              ]
            },
            "description": "Fetches historical order details and frozen snapshot data (product pricing, quantities, applied discounts, totals) by orderId."
          },
          "response": []
        }
      ]
    },
    {
      "name": "4. Coupons",
      "item": [
        {
          "name": "Attempt coupon generation before milestone",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/generate-coupon",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "generate-coupon"
              ]
            },
            "description": "Attempts administrative coupon generation before the order milestone (e.g. 5 orders) is reached. Rejects with HTTP 400 Bad Request."
          },
          "response": []
        },
        {
          "name": "Generate coupon when milestone is eligible",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Helper: ensures at least 5 orders are placed so milestone 1 is eligible",
                  "for (var i = 1; i <= 5; i++) {",
                  "    (function(idx) {",
                  "        var u = 'u_milestone_' + idx + '_' + Date.now();",
                  "        pm.sendRequest({",
                  "            url: pm.collectionVariables.get('baseUrl') + '/api/cart/add',",
                  "            method: 'POST',",
                  "            header: { 'Content-Type': 'application/json' },",
                  "            body: {",
                  "                mode: 'raw',",
                  "                raw: JSON.stringify({ userId: u, productId: 4, qty: 1 })",
                  "            }",
                  "        }, function () {",
                  "            pm.sendRequest({",
                  "                url: pm.collectionVariables.get('baseUrl') + '/api/checkout',",
                  "                method: 'POST',",
                  "                header: { 'Content-Type': 'application/json' },",
                  "                body: {",
                  "                    mode: 'raw',",
                  "                    raw: JSON.stringify({ userId: u })",
                  "                }",
                  "            }, function () {});",
                  "        });",
                  "    })(i);",
                  "}"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    if (json.coupon && json.coupon.code) {",
                  "        pm.collectionVariables.set('couponCode', json.coupon.code);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/generate-coupon",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "generate-coupon"
              ]
            },
            "description": "Generates a 10% discount coupon for an eligible milestone (e.g., 5th order). Returns HTTP 201 Created and saves couponCode to collection variables."
          },
          "response": []
        },
        {
          "name": "Checkout using a valid coupon",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Ensure u_coupon_user has Shirt (1000) in cart",
                  "pm.sendRequest({",
                  "    url: pm.collectionVariables.get('baseUrl') + '/api/cart/add',",
                  "    method: 'POST',",
                  "    header: { 'Content-Type': 'application/json' },",
                  "    body: {",
                  "        mode: 'raw',",
                  "        raw: JSON.stringify({ userId: 'u_coupon_user', productId: 1, qty: 1 })",
                  "    }",
                  "}, function (err, res) {});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"u_coupon_user\",\n  \"discountCode\": \"{{couponCode}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/checkout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "checkout"
              ]
            },
            "description": "Applies a valid milestone coupon at checkout. Verifies 10% discount deduction and transitions coupon status to REDEEMED."
          },
          "response": []
        },
        {
          "name": "Attempt to redeem an already redeemed coupon",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Ensure u_coupon_user_2 has an item in cart",
                  "pm.sendRequest({",
                  "    url: pm.collectionVariables.get('baseUrl') + '/api/cart/add',",
                  "    method: 'POST',",
                  "    header: { 'Content-Type': 'application/json' },",
                  "    body: {",
                  "        mode: 'raw',",
                  "        raw: JSON.stringify({ userId: 'u_coupon_user_2', productId: 1, qty: 1 })",
                  "    }",
                  "}, function (err, res) {});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"u_coupon_user_2\",\n  \"discountCode\": \"{{couponCode}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/checkout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "checkout"
              ]
            },
            "description": "Single-use enforcement. Attempts to redeem the same coupon code again. Rejects with HTTP 400 Bad Request ('Invalid or expired discount code')."
          },
          "response": []
        }
      ]
    },
